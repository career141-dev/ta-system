{
  "manifest_version": 3,
  "name": "Career141 — Capture from LinkedIn",
  "version": "0.2.3",
  "description": "Files the LinkedIn profile you are looking at into a Career141 opening. One profile, one button press, by you.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://localhost/*",
    "https://ta-system.career141.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Career141",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/in/*",
        "https://*.linkedin.com/talent/profile/*",
        "https://*.linkedin.com/talent/hire/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
