# The TA System's production settings. Copy to /srv/ta-system/.env.production on
# the server, fill in the real values, and keep it out of git (chmod 600).
# Nothing here may be committed with a real value in it.

# ── The backend ──────────────────────────────────────────────────────────────
# In the container these two come from docker-compose.ta.yml; set them here only
# when running the app directly on the host (then use http://127.0.0.1:3210).
# CONVEX_SELF_HOSTED_URL=http://backend:3210
# C141_CONVEX_HOST=backend
CONVEX_SELF_HOSTED_ADMIN_KEY=

# This is the production deployment. It is what allows the app to start against
# a backend whose crons are on and whose messages reach real people.
C141_DEPLOYMENT=production

# ── Sessions and the nightly job ─────────────────────────────────────────────
# Long random values, different from each other: openssl rand -base64 48
C141_SESSION_SECRET=
C141_CRON_SECRET=

# ── Sign-in (Clerk) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Where CVs arrive (optional; leave unset to keep today's behaviour) ───────
# C141_TA_INTAKE=true

# ── Usage analytics (optional) ───────────────────────────────────────────────
# Microsoft Clarity project id (clarity.microsoft.com → Settings → Overview).
# Unset = no Clarity. Page text is masked in code (src/app/layout.tsx); also set
# Settings → Masking → Strict in Clarity itself.
# CLARITY_PROJECT_ID=

# ── Messages to people ────────────────────────────────────────────────────────
# Set on the CONVEX backend (npx convex env set), not here: OUTREACH_LIVE=true is
# what lets WhatsApp and email reach candidates on production.

# ── Never set on production ──────────────────────────────────────────────────
# C141_DEV_SIGNIN, C141_STORE, C141_TEST_RUN, C141_DISABLE_CRONS,
# C141_OUTBOUND_LOCK, and anything beginning C141_LIVE_.
