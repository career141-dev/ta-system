{
  "name": "career141-ta-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100 --webpack",
    "build": "next build --webpack",
    "start": "next start -p 3100",
    "lint": "next lint",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "test": "node tests/run.mjs",
    "typecheck": "tsc --noEmit",
    "bench": "node --max-old-space-size=12000 --import ./tests/alias.mjs tests/benchmark.ts",
    "live:check": "node --import ./tests/alias.mjs scripts/live-check.ts",
    "live:sync": "node --max-old-space-size=12000 --import ./tests/alias.mjs scripts/live-sync.ts",
    "db:restore": "node scripts/restore-local.mjs",
    "convex:dev": "node scripts/convex-local-only.mjs dev",
    "convex:dev:once": "node scripts/convex-local-only.mjs dev --once",
    "convex:logs": "node scripts/convex-local-only.mjs logs",
    "convex:logs:prod": "npx convex logs --url https://api.career141.com --admin-key $CONVEX_PROD_ADMIN_KEY",
    "convex:logs:staging": "ssh root@94.136.189.48 \"cd /opt/ta-staging && npx convex logs --url http://127.0.0.1:3220 --admin-key $CONVEX_STAGING_ADMIN_KEY\"",
    "convex:logs:staging:docker": "ssh root@94.136.189.48 \"docker logs -f ta-staging-convex\"",
    "convex:codegen": "node scripts/convex-local-only.mjs codegen",
    "convex:import": "node scripts/convex-local-only.mjs import",
    "e2e": "node scripts/e2e/run-all.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@clerk/nextjs": "^7.9.2",
    "@qdrant/js-client-rest": "^1.19.0",
    "convex": "^1.45.0",
    "jimp": "^1.6.1",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.17.0",
    "mammoth": "^1.12.0",
    "next": "^16.3.5",
    "openai": "^6.43.0",
    "pdf-lib": "^1.17.1",
    "pdf2json": "^4.0.3",
    "pdfjs-dist": "5.7.284",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
