# Convex settings the pipeline SETS on the production deployment before every
# functions deploy. Non-secret values only — this file is in git.
#
# Whether production sends messages (OUTREACH_LIVE) and runs its scheduled jobs
# is a business decision made on the deployment itself, not something a code
# push should change — so neither is here.

# The live Qdrant, by its name on the career141 network. The code falls back to
# the same address; pinned so the setting is visible rather than implied.
QDRANT_URL=http://qdrant:6333

# File CVs arriving at linkedin@ and cv@ by job post — LinkedIn job number,
# campaign code, exact / old title / alias — with no model guessing
# (convex/pipeline/postFiling.ts). Turned on by the owner, 22 September.
# To go back to the old routing, change it to `off` and release — the
# pipeline sets values, it never removes one.
C141_POST_ROUTING=on

# The end-of-day email's own test mailbox (convex/lib/outreachSafety.ts). While
# OUTREACH_LIVE is off every email goes to a test mailbox; the end-of-day email
# used the general OUTREACH_TEST_EMAIL, a developer's Gmail, so the Director's
# shortlist — names, salaries, CVs — went to an outside address (owner, 6 Oct).
# Its own test mailbox is the desk's job-orders inbox, which it is sent to
# anyway, so it reaches only Career141 addresses. Candidate follow-ups are
# unchanged.
EOD_TEST_EMAIL=joborders@career141.com
