# Convex settings the pipeline SETS on the staging deployment before every
# functions deploy. Non-secret values only — this file is in git.
#
# Staging holds a copy of real candidates and real mailboxes. These two keep it
# from polling live inboxes or messaging anyone; the app refuses to start
# without them (src/lib/safety.ts).
C141_DISABLE_CRONS=true
C141_OUTBOUND_LOCK=true

# TA System mail intake (convex/mailIntake): registers its read-only sync of
# linkedin@, cv@ and job@. Each mailbox still starts switched off and is turned
# on in Settings → Mailboxes. It never marks mail read or replies, so the CV
# platform's own polling is unaffected.
C141_MAIL_INTAKE=on
