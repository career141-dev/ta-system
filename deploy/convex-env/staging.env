# Convex settings the pipeline SETS on the staging deployment before every
# functions deploy. Non-secret values only — this file is in git.
#
# Staging holds a copy of real candidates and real mailboxes. These two keep it
# from polling live inboxes or messaging anyone; the app refuses to start
# without them (src/lib/safety.ts).
C141_DISABLE_CRONS=true
C141_OUTBOUND_LOCK=true

# TA System mail intake (convex/mailIntake): the read-only sync of the real
# linkedin@, cv@ and job@ mailboxes. It never marks mail read or replies, and
# each mailbox also has its own switch in Settings → Mailboxes.
#
# On since 16 September, by the desk's decision, as a trial with linkedin@
# only (cv@ and job@ stay switched off in Settings → Mailboxes). CV files land
# in the same R2 bucket as production under new, unique keys — duplicates, never
# overwrites — and the records go into staging's own database.
C141_MAIL_INTAKE=on

# The candidate follow-up sweep, for TA openings only (convex/crons.ts). Every
# message it sends still goes through the outreach gate below.
C141_TA_FOLLOW_UP=on

# The CV queue, the stuck-upload recovery and the healer — the jobs that keep a
# failed extraction from sitting for ever. They contact nobody.
C141_TA_MAINTENANCE=on

# Staging never writes to a candidate. OUTREACH_LIVE is forbidden here
# (staging.required), so convex/lib/outreachSafety.ts redirects every message —
# whoever it was addressed to — to these two, and convex/lib/outboundGuard.ts
# refuses anything else as a second, independent check.
OUTREACH_TEST_PHONE=+94742197476
OUTREACH_TEST_EMAIL=hipergrin@gmail.com
C141_OUTBOUND_ALLOW_PHONES=+94742197476
C141_OUTBOUND_ALLOW_EMAILS=hipergrin@gmail.com

# Which mailbox the follow-up email is sent from, and where replies return to.
MS_SENDER_EMAIL=job@career141.com
OUTBOUND_EMAIL_SENDER=job@career141.com
