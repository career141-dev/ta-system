# Convex settings that must already be set on the staging deployment, or the
# deploy stops before touching anything. Secrets are set once on the deployment
# (dashboard, or `npx convex env set NAME value` through the tunnel) — never in
# git or in GitHub.
#
#   NAME        must be set
#   A|B         at least one of them
#   !NAME       must NOT be set
C141_DISABLE_CRONS
C141_OUTBOUND_LOCK
OPENAI_API_KEY|OPENROUTER_API_KEY
QDRANT_URL
QDRANT_API_KEY
R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY
R2_ENDPOINT
R2_BUCKET_NAME
!OUTREACH_LIVE
# Outreach: without these a deploy succeeds and every follow-up fails silently
# at send time (convex/communications/metaTemplateSender.ts, lib/graphMail.ts).
META_ACCESS_TOKEN
META_PHONE_NUMBER_ID
# Inbound WhatsApp: without these the webhook refuses every request (503) —
# it verifies Meta's X-Hub-Signature-256 and the handshake token rather than
# trusting whatever reaches the URL (convex/lib/webhookSecurity.ts, 23 Sep).
META_APP_SECRET
META_VERIFY_TOKEN
MS_GRAPH_CLIENT_ID|MS_CLIENT_ID
MS_GRAPH_CLIENT_SECRET|MS_CLIENT_SECRET
MS_GRAPH_TENANT_ID|MS_TENANT_ID
