node_modules
.next
.data
*.tsbuildinfo
next-env.d.ts

# Secrets — never commit. The server's file is .env.production; only the
# example, which holds no values, belongs in git.
.env
.env.local
.env*.local
.env.production

# SSH deploy keys — generated locally, injected by CI; never stored in git
github_deploy_key
github_deploy_key.pub

# Local embedding model runtime
tools/embed/.venv
.data-live-test
tools/embed/models
*.log
# Local Claude state (worktrees, launch config, personal settings) stays out;
# the team's shared skills are tracked.
.claude/*
!.claude/skills/

# Invented sample data for UI-only work (deploy/local/start-ui.sh)
.data-ui

# Python artifacts and one-off debug scripts
__pycache__/
*.pyc
count_tables.py
# PDF.js workers are copied from the installed dependency by next.config.ts.
/public/pdfjs/
